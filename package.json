{
  "name": "jai-dubber",
  "private": true,
  "version": "1.0.5",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --minify --legal-comments=none --outfile=dist/server.cjs && node -e \"const fs=require('fs'),path=require('path'); if(fs.existsSync('dist/server.cjs.map')) fs.unlinkSync('dist/server.cjs.map'); const d=path.join('dist','server'); if(!fs.existsSync(d)) fs.mkdirSync(d,{recursive:true}); for(const f of ['whisper_transcribe.py','demucs_separate.py','check_ai_engine.py','audio_pitch_detector.py','setup_ai_engine.ps1']) if(fs.existsSync(path.join('server',f))) fs.copyFileSync(path.join('server',f),path.join(d,f)); const adSrc=path.join('server','autodub'), adDst=path.join(d,'autodub'); if(fs.existsSync(adSrc)) fs.cpSync(adSrc, adDst, {recursive: true}); const asSrc='assets', asDst=path.join('dist','assets'); if(fs.existsSync(asSrc)) fs.cpSync(asSrc, asDst, {recursive: true});\"",
    "dist:win": "node scripts/build-dist.cjs both",
    "dist:installer": "node scripts/build-dist.cjs nsis",
    "dist": "node scripts/build-dist.cjs both",
    "bot": "node scripts/telegram-bot.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.jaidubber.app",
    "productName": "JAI DUBBER",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JAI DUBBER",
      "artifactName": "${productName} ${version} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
